# Copy this to .env — the CLI does this automatically for new projects
# and fills in fresh, random values for the secrets below.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# PostgreSQL (swap the datasource provider in prisma/schema.prisma to "postgresql"):
# DATABASE_URL="postgresql://user:password@localhost:5432/secure_stack"

# ── Secrets (generated fresh per project by the CLI) ─────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters.
JWT_SECRET="replace-me"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes) — used for AES-256-GCM.
FIELD_ENCRYPTION_KEY="replace-me"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── CORS / Cookie ─────────────────────────────────────────────────────────────
# URL of your frontend. Used for CORS origin allowlist and Origin header validation.
# ⚠ IMPORTANT: frontend and backend must share a registrable domain in production
# for SameSite=Lax cookies to be sent cross-subdomain (e.g. app.example.com →
# api.example.com is fine; Vercel + Render with their default domains is NOT).
# See docs/API.md for cross-domain deployment guidance.
FRONTEND_URL="http://localhost:5173"

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to enable the Secure cookie flag and JSON-only logging.
NODE_ENV=development
